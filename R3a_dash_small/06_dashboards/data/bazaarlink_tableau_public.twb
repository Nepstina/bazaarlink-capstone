      <aliases enabled='yes' />
      <column caption='Orders' datatype='integer' name='[Calculation_0197976326406144]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Revenue' datatype='real' name='[Calculation_0197976326737921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_delivered] = 1 THEN [item_revenue] END)' />
      </column>
      <column caption='On-time %' datatype='real' default-format='p0.0%' name='[Calculation_0197976326828034]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_on_time]) / SUM([is_delivery_measurable])' />
      </column>
      <column caption='Late %' datatype='real' default-format='p0.0%' name='[Calculation_0197976326946819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_late]) / SUM([is_delivery_measurable])' />
      </column>
      <column caption='Negative Review %' datatype='real' default-format='p0.0%' name='[Calculation_0197976327028740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([is_negative_review])' />
      </column>
      <column caption='Avg Review Score' datatype='real' name='[Calculation_0197976327098373]' role='measure' type='quantitative'>
